*.gz
*.zip
*.xlsx
*.xls
*.doc
*.docx

# ── large or per-variant result files (stay on Drive) ────────────────────────
# parquet tables include per-variant COSMIC-derived rows; npz/pt are embeddings and model weights.
*.parquet
*.npz
*.pt
*.cif
results/**/cache/

