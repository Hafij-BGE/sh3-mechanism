# ── never commit data ────────────────────────────────────────────────────────
# COSMIC's licence forbids redistribution; raw archives are large and live on Drive.
*.tsv
*.tsv.gz
*.gz
*.zip
*.xlsx
*.xls
*.doc
*.docx

# ── large or per-variant result files (stay on Drive) ────────────────────────
# parquet tables include per-variant COSMIC-derived rows; npz/pt are embeddings and model weights.
*.parquet
*.npz
*.pt
*.cif
results/**/cache/

# ── local clutter ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
~$*
.~lock.*#
drive_upload/

# ── per-variant follow-up table (COSMIC variants with tumour sites) ──────────

# ── kept on the laptop only ──────────────────────────────────────────────────
SH3_all_possible_upgrades_from_base_notebook.md

# ── local input mirror and caches (never commit: COSMIC data, 7.5 GB) ────────
database/
cache/

# ── setup guides kept on the laptop only ────────────────────────────────────
GITHUB_GUIDE.md
UPLOAD_GUIDE.md

# ── large media and the duplicate reading copy (kept on the laptop) ─────────
*.mp4
*.pptx
results/SH3_Mutation_Mechanism_Blueprint.pdf
result analysis/

# --- extended/ (phase 2: external validation) -------------------------------
# git does not descend into an excluded directory, so each level is excluded by its
# contents and re-admitted, to let through the two small derived tables E4 reads.
# Kazemein Jasemi et al. 2024 is CC BY, which permits redistribution with attribution
# (docs/DATA.md and DATA_PROVENANCE.md give it); without them E4 cannot be reproduced
# from the repository alone. Everything else under input/ stays out.
extended/input/*
!extended/input/external/
extended/input/external/*
!extended/input/external/binding/
extended/input/external/binding/*
!extended/input/external/binding/*.csv
extended/Downloded data/
extended/absolute-stability-predictor/
extended/results/**/*.parquet

# The complete atlas must not be republished, in any dressing: atlas_with_external.csv
# is SH3_cancer_master.tsv plus extra columns. Derived analysis tables (subsets with
# predictions and external measurements, no COSMIC fields) are fine to publish.
extended/results/**/atlas_with_external.csv

# Large regenerable exports (X0 rebuilds them; they are on Drive)
extended/results/X0_external_data/gnomad_sh3_missense.csv
extended/results/X0_external_data/clinvar_sh3.csv
extended/results/X0_external_data/domainome_sh3_variants.csv

# in-progress browser downloads, and dbNSFP staged at the extended/ root
*.crdownload
extended/*.csv
